{
  "name": "uni-hmr",
  "version": "0.1.0-rc.3",
  "description": "Hot update tool for uni-app development: automatic build, incremental sync to a real device and runtime refresh",
  "type": "module",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaikoTan/uni-hmr.git"
  },
  "homepage": "https://github.com/MaikoTan/uni-hmr#readme",
  "bugs": {
    "url": "https://github.com/MaikoTan/uni-hmr/issues"
  },
  "bin": "dist/uni-hmr.mjs",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@types/node": "~22",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@4.18.1"
}
